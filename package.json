{
  "name": "english-trainer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "validate:content": "bun scripts/validate-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build": "bun run validate:content && bun run test && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "icons": "bun scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "description": "English Trainer – Englisch lernen im Duolingo-Stil: Einstufungstest, Basiskurs A1–B2 und Spezialisierungen (localStorage, PWA)"
}
