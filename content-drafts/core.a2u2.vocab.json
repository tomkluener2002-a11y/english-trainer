[
  { "id": "core.a2u2.yesterday", "en": "yesterday", "de": "gestern", "pos": "adv", "example": "Yesterday I cooked pasta.", "exampleDe": "Gestern kochte ich Nudeln.", "note": "Ohne Präposition: „yesterday“, nicht „on yesterday“." },
  { "id": "core.a2u2.walked", "en": "walked", "de": "ging zu Fuß", "pos": "verb", "example": "I walked to the park yesterday.", "exampleDe": "Ich ging gestern zu Fuß zum Park.", "altDe": ["spazierte"], "note": "Grundform: walk. Regelmäßig: + -ed." },
  { "id": "core.a2u2.played", "en": "played", "de": "spielte", "pos": "verb", "example": "We played football yesterday.", "exampleDe": "Wir spielten gestern Fußball.", "note": "Grundform: play (spielen). Regelmäßig: + -ed." },
  { "id": "core.a2u2.cooked", "en": "cooked", "de": "kochte", "pos": "verb", "example": "My mother cooked dinner yesterday.", "exampleDe": "Meine Mutter kochte gestern das Abendessen.", "note": "Grundform: cook (kochen). Regelmäßig: + -ed." },
  { "id": "core.a2u2.watched", "en": "watched", "de": "sah (fern) / schaute an", "pos": "verb", "example": "I watched a film last night.", "exampleDe": "Ich sah gestern Abend einen Film.", "note": "Grundform: watch. Bei Filmen und Serien: „watch a film“." },
  { "id": "core.a2u2.studied", "en": "studied", "de": "lernte / studierte", "pos": "verb", "example": "She studied English at school.", "exampleDe": "Sie lernte Englisch in der Schule.", "note": "Aus study wird studied: y nach Konsonant wird zu -ied." },
  { "id": "core.a2u2.went", "en": "went", "de": "ging", "pos": "verb", "example": "We went to the cinema.", "exampleDe": "Wir gingen ins Kino.", "altDe": ["fuhr"], "note": "Grundform: go (gehen). Unregelmäßig: nicht „goed“ sagen." },
  { "id": "core.a2u2.saw", "en": "saw", "de": "sah", "pos": "verb", "example": "I saw a nice bag.", "exampleDe": "Ich sah eine schöne Tasche.", "note": "Grundform: see (sehen). „seen“ brauchst du nur mit have." },
  { "id": "core.a2u2.had", "en": "had", "de": "hatte", "pos": "verb", "example": "We had pasta for dinner.", "exampleDe": "Wir hatten Nudeln zum Abendessen.", "note": "Grundform: have (haben)." },
  { "id": "core.a2u2.ate", "en": "ate", "de": "aß", "pos": "verb", "example": "I ate an apple after school.", "exampleDe": "Ich aß nach der Schule einen Apfel.", "note": "Grundform: eat (essen)." },
  { "id": "core.a2u2.bought", "en": "bought", "de": "kaufte", "pos": "verb", "example": "Ben bought a new bike.", "exampleDe": "Ben kaufte ein neues Fahrrad.", "note": "Grundform: buy (kaufen). Nicht „buyed“." },
  { "id": "core.a2u2.took", "en": "took", "de": "nahm / machte (ein Foto)", "pos": "verb", "example": "I took a photo of the park.", "exampleDe": "Ich machte ein Foto vom Park.", "note": "Grundform: take. „Ein Foto machen“ heißt auf Englisch „take a photo“, nicht „make a photo“." },
  { "id": "core.a2u2.weekend", "en": "weekend", "de": "das Wochenende", "pos": "noun", "example": "I was tired at the weekend.", "exampleDe": "Am Wochenende war ich müde.", "altEn": ["the weekend"], "altDe": ["Wochenende"], "note": "Britisch: „at the weekend“. Mit „last“ keine Präposition: „last weekend“." },
  { "id": "core.a2u2.last", "en": "last", "de": "letzte / letzter / letztes", "pos": "adj", "example": "Last weekend we went to the cinema.", "exampleDe": "Letztes Wochenende gingen wir ins Kino.", "altDe": ["letzte", "letzter", "letztes"], "note": "Vor „last“ keine Präposition: „last weekend“, nicht „on last weekend“." },
  { "id": "core.a2u2.cinema", "en": "cinema", "de": "das Kino", "emoji": "🎬", "pos": "noun", "example": "We went to the cinema on Friday.", "exampleDe": "Am Freitag gingen wir ins Kino.", "altEn": ["the cinema", "movie theater"], "altDe": ["Kino"], "note": "Wohin: „to the cinema“ (ins Kino). Wo: „at the cinema“ (im Kino)." },
  { "id": "core.a2u2.party", "en": "party", "de": "die Party / Feier", "emoji": "🥳", "pos": "noun", "example": "Ben invited us to his party.", "exampleDe": "Ben hat uns zu seiner Party eingeladen.", "altDe": ["Party", "Feier"], "note": "Achtung: die Partei heißt „political party“." },
  { "id": "core.a2u2.shopping", "en": "shopping", "de": "das Einkaufen", "emoji": "🛍️", "pos": "noun", "example": "We went shopping on Saturday.", "exampleDe": "Wir gingen am Samstag einkaufen.", "altDe": ["einkaufen"], "note": "„go shopping“ heißt einkaufen gehen." },
  { "id": "core.a2u2.tired", "en": "tired", "de": "müde", "emoji": "😴", "pos": "adj", "example": "I was tired after the party.", "exampleDe": "Ich war nach der Party müde.", "altDe": ["erschöpft"], "note": "„tired“ heißt müde, nicht traurig („sad“)." },
  { "id": "core.a2u2.did", "en": "did", "de": "Hilfsverb für Fragen (Vergangenheit)", "pos": "other", "example": "Did you have fun?", "exampleDe": "Hattest du Spaß?", "note": "Nach did steht die Grundform: „Did you go?“, nicht „Did you went?“." },
  { "id": "core.a2u2.didnt", "en": "didn't", "de": "nicht (Vergangenheit verneint)", "pos": "other", "example": "I didn't sleep well.", "exampleDe": "Ich schlief nicht gut.", "altEn": ["did not"], "note": "Verneinung mit didn't, danach die Grundform: „I didn't go.“" },
  { "id": "core.a2u2.where", "en": "where", "de": "wo / wohin", "pos": "other", "example": "Where did you go?", "exampleDe": "Wohin bist du gegangen?", "note": "Fragt nach dem Ort: „Where did you go?“" },
  { "id": "core.a2u2.slept", "en": "slept", "de": "schlief", "pos": "verb", "example": "I slept nine hours last night.", "exampleDe": "Ich schlief letzte Nacht neun Stunden.", "note": "Grundform: sleep (schlafen). Unregelmäßig." },
  { "id": "core.a2u2.happened", "en": "happened", "de": "passierte / geschah", "pos": "verb", "example": "What happened yesterday?", "exampleDe": "Was ist gestern passiert?", "note": "Grundform: happen. „What happened?“ heißt „Was ist passiert?“ – der Titel dieser Unit." }
]
