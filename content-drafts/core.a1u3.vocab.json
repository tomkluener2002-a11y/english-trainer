  { "id": "core.a1u3.how-much", "en": "How much is it?", "de": "Was kostet das?", "pos": "phrase", "example": "How much is the bread?", "exampleDe": "Was kostet das Brot?", "altEn": ["how much is it", "how much is this", "how much is that"], "altDe": ["Wie viel kostet das?", "Was kostet es?"], "note": "Für Preise. Für Mengen gilt How much milk? – Wie viel Milch?" },
  { "id": "core.a1u3.cheap", "en": "cheap", "de": "billig / günstig", "pos": "adj", "example": "The apples are cheap.", "exampleDe": "Die Äpfel sind billig.", "altDe": ["billig", "günstig", "preiswert"], "note": "Gegenteil: expensive (teuer)." },
