  { "id": "core.a1u3.menu", "en": "menu", "de": "die Speisekarte", "emoji": "📋", "pos": "noun", "example": "Here is the menu.", "exampleDe": "Hier ist die Speisekarte.", "altDe": ["Speisekarte", "Karte"], "note": "Achtung: menu heißt die Speisekarte. Ein Menü mit mehreren Gängen heißt auf Englisch set menu." },
  { "id": "core.a1u3.i-would-like", "en": "I would like", "de": "Ich möchte …", "pos": "phrase", "example": "I would like a tea, please.", "exampleDe": "Ich möchte bitte einen Tee.", "altEn": ["I'd like"], "altDe": ["ich möchte", "ich hätte gern"], "note": "Höflicher als I want. Danach folgt die Grundform: I would like tea, nicht likes." },
  { "id": "core.a1u3.like", "en": "like", "de": "mögen / gern haben", "pos": "verb", "example": "I like pizza.", "exampleDe": "Ich mag Pizza.", "altDe": ["mögen", "mag", "gern haben"], "note": "Danach ein Nomen oder ein Tunwort mit -ing: I like swimming." },
  { "id": "core.a1u3.dont-like", "en": "don't like", "de": "nicht mögen", "pos": "phrase", "example": "I don't like rice.", "exampleDe": "Ich mag keinen Reis.", "altEn": ["do not like", "dont like"], "altDe": ["nicht mögen", "mag nicht", "mag keinen"], "note": "Bei he/she/it: doesn't like, z.B. He doesn't like tea." },
