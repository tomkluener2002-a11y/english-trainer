{
  "id": "core.b2u4",
  "title": "Formelle Sprache",
  "description": "Register wechseln: formell, neutral, umgangssprachlich.",
  "cefr": "B2",
  "color": "blue",
  "icon": "🎩",
  "topics": ["Formelle E-Mails", "Höflichkeitsformen", "Phrasal Verbs vs. formell", "Präsentieren"],
  "status": "ready",
  "milestone": true,
  "tips": [
    {
      "title": "Would you mind + -ing, Could you possibly + Infinitiv",
      "text": "Nach Would you mind folgt immer die -ing-Form. Could you possibly dagegen steht mit dem Infinitiv ohne to. Beide Konstruktionen machen eine Bitte höflicher als ein Imperativ.",
      "examples": [
        { "en": "Would you mind waiting a moment?", "de": "Würde es Ihnen etwas ausmachen, kurz zu warten?" },
        { "en": "Could you possibly send me the file?", "de": "Könnten Sie mir vielleicht die Datei schicken?" },
        { "en": "Send me the file.", "de": "Schicken Sie mir die Datei. (direkt, für formelle Texte zu knapp)" }
      ]
    },
    {
      "title": "Anrede und Gruß passen zusammen",
      "text": "Kennst du den Namen nicht, schreibst du Dear Sir or Madam und endest mit Yours faithfully (Hochachtungsvoll). Kennst du den Namen, passt Dear Mr Kim, mit Yours sincerely (Mit freundlichen Grüßen).",
      "examples": [
        { "en": "Dear Sir or Madam, … Yours faithfully,", "de": "Sehr geehrte Damen und Herren, … Hochachtungsvoll," },
        { "en": "Dear Mr Kim, … Yours sincerely, Anna", "de": "Sehr geehrter Herr Kim, … Mit freundlichen Grüßen, Anna" }
      ]
    },
    {
      "title": "Phrasal Verbs vs. formelle Verben",
      "text": "Im Alltag sagt man look into, sort out und put off. In formellen Texten und Berichten passen eher investigate, resolve und postpone. Phrasal Verbs klingen locker, Einzelverben sachlich.",
      "examples": [
        { "en": "We will look into the problem.", "de": "Wir werden dem Problem nachgehen." },
        { "en": "We need to resolve the issue.", "de": "Wir müssen das Problem lösen." }
      ]
    }
  ],
